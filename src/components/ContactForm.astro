---
import { site } from '../data/site';

/* Contact only. Shoots are booked through the external portal — see
   BOOKING_URL in src/data/site.ts — so this form deliberately does not collect
   an address, square footage, a package, or preferred dates.

   GitHub Pages cannot run server code, so the form posts to Formspree over
   fetch — see src/scripts/form.js. The form ID is mdeokplg; it comes from
   PUBLIC_FORMSPREE_ID rather than being hardcoded so a fork or a preview build
   can point somewhere else. .env is gitignored, so a fresh clone needs it
   recreating — the value is recorded in CONTENT-TODO.md §1. */
const formId = import.meta.env.PUBLIC_FORMSPREE_ID ?? '';
const endpoint = formId ? `https://formspree.io/f/${formId}` : '';

/* Formspree reads _subject as the notification email's subject line. The host
   comes off Astro.site so the domain is not written down a second time. */
const subject = `New contact from ${Astro.site?.host ?? 'the website'}`;
---

<section class="section section--hair" id="contact">
  <div class="wash wash--soft" aria-hidden="true"></div>

  <div class="wrap contact">
    <div class="contact__aside reveal">
      <p class="mono">Get in touch</p>
      <h2 class="display contact__title">Questions before you book?</h2>
      <p class="prose contact__intro">
        Booking happens on the portal — this is for anything else. Coverage,
        turnaround, an unusual property, a quote for something not on the page.
        If it is time-sensitive, call.
      </p>

      <div class="contact__direct">
        <a class="contact__phone" href={site.phoneHref}>{site.phone}</a>
        <p class="mono contact__phone-note">
          Call or text · <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>

    <div class="contact__panel reveal">
      <form
        class="form"
        data-contact-form
        action={endpoint || undefined}
        method="post"
        novalidate
        data-fail-msg={`That did not send — the connection dropped somewhere. Try again, or call ${site.phone}.`}
      >
        <p class="form__error" data-form-error hidden role="alert"></p>

        <div class="form__row">
          <div class="field">
            <label class="field__label" for="name">Your name</label>
            <input class="field__input" id="name" name="name" type="text" autocomplete="name" required
              data-msg="Enter your name so we know who we are replying to." />
            <p class="field__msg" data-msg-for="name" hidden></p>
          </div>

          <div class="field">
            <label class="field__label" for="brokerage">Brokerage <span class="field__opt">optional</span></label>
            <input class="field__input" id="brokerage" name="brokerage" type="text" autocomplete="organization" />
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label class="field__label" for="email">Email</label>
            <input class="field__input" id="email" name="email" type="email" autocomplete="email" required
              data-msg="Enter an email so we can reply."
              data-msg-format="That address is missing an @ — check it and try again." />
            <p class="field__msg" data-msg-for="email" hidden></p>
          </div>

          <div class="field">
            <label class="field__label" for="phone">Phone <span class="field__opt">optional</span></label>
            <input class="field__input" id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="message">What can we help with</label>
          <textarea class="field__input field__input--area" id="message" name="message" rows="5" required
            data-msg="Tell us what you need and we will come back to you."
            placeholder="A question about pricing, coverage, turnaround, or anything else."></textarea>
          <p class="field__msg" data-msg-for="message" hidden></p>
        </div>

        <input type="hidden" name="_subject" value={subject} />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />

        <button class="btn btn--primary btn--wide form__submit" type="submit" data-form-submit>
          Send message
        </button>
      </form>

      <div class="done" data-form-done hidden>
        <p class="mono">Message sent</p>
        <h3 class="display done__title">Got it, thanks.</h3>
        <p class="done__body">
          We will come back to you by email or text. If it is urgent, call
          <a class="link" href={site.phoneHref}>{site.phone}</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
    align-items: start;
  }

  .contact__title {
    margin-top: 18px;
    font-size: var(--fs-40);
  }
  .contact__intro {
    margin-top: 20px;
  }

  .contact__direct {
    margin-top: 34px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .contact__phone {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 118%;
    font-size: var(--fs-28);
    letter-spacing: -0.01em;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-hover) var(--ease);
  }
  .contact__phone:hover {
    border-bottom-color: var(--glow);
  }
  .contact__phone-note {
    margin-top: 10px;
  }

  .contact__panel {
    border: 1px solid var(--line-soft);
    background: var(--night);
    padding: 26px;
  }

  .form {
    display: grid;
    gap: 20px;
  }
  .form__row {
    display: grid;
    gap: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .field__label {
    font-size: var(--fs-14);
    font-weight: 500;
  }
  .field__opt {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
    margin-left: 6px;
  }
  .field__input {
    width: 100%;
    padding: 13px 14px;
    background: var(--ink);
    border: 1px solid var(--line);
    color: var(--paper);
    font-size: var(--fs-16);
    transition: border-color var(--t-hover) var(--ease);
  }
  .field__input::placeholder {
    color: var(--muted);
    opacity: 0.75;
  }
  .field__input:hover {
    border-color: var(--line-lift);
  }
  .field__input:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 1px;
    border-color: var(--signal);
  }
  .field__input--area {
    resize: vertical;
    min-height: 128px;
    font-family: var(--font-body);
  }

  .field[data-invalid] .field__input {
    border-color: var(--glow);
  }
  .field__msg {
    font-size: var(--fs-14);
    color: var(--glow);
  }
  .field__msg[hidden] {
    display: none;
  }

  .form__error {
    padding: 14px 16px;
    border: 1px solid var(--glow);
    color: var(--paper);
    font-size: var(--fs-14);
  }
  .form__error[hidden] {
    display: none;
  }

  .form__submit {
    margin-top: 6px;
  }
  .form__submit[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }
  .done {
    padding-block: 20px;
  }
  .done[hidden] {
    display: none;
  }
  .done__title {
    margin-top: 16px;
    font-size: var(--fs-28);
  }
  .done__body {
    margin-top: 18px;
    color: var(--muted);
    max-width: 46ch;
  }

  @media (min-width: 620px) {
    .form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 980px) {
    .contact {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }
    .contact__panel {
      padding: 32px;
    }
  }
</style>

<script>
  import '../scripts/form.js';
</script>
