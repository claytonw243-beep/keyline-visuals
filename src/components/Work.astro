---
import { Picture, getImage } from 'astro:assets';
import { gallery, filters } from '../data/gallery';

interface Props {
  limit?: number;
  heading?: string;
  eyebrow?: string;
  intro?: string;
  headingLevel?: 'h1' | 'h2';
}

const {
  limit,
  heading = 'Recent listings',
  eyebrow = 'The work',
  intro = 'Every frame here is from a real listing in the coverage area. Filter it down to whatever you are about to shoot.',
  headingLevel = 'h2',
} = Astro.props;

const shots = limit ? gallery.slice(0, limit) : gallery;
const Heading = headingLevel;

/* The lightbox is vanilla JS and sets img.src from a data attribute, so it
   needs a concrete URL. Generate one derivative per shot at build time. */
const lightboxSrc = await Promise.all(
  shots.map((shot) => getImage({ src: shot.image, width: 1600, format: 'webp' }))
).then((images) => images.map((image) => image.src));

/* Cap the column count at the number of photos so a partial set does not leave
   empty columns. */
const cols = `--cols-md:${Math.min(2, shots.length)};--cols-lg:${Math.min(3, shots.length)}`;

/* Only show the full-gallery link when there is more to see. */
const hasMore = Boolean(limit) && gallery.length > shots.length;
---

<section class="section section--hair" id="work">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="mono">{eyebrow}</p>
      <Heading class="display">{heading}</Heading>
      <p class="prose">{intro}</p>
    </div>

    <div class="work__filters reveal" role="group" aria-label="Filter the gallery">
      {
        filters.map((f, i) => (
          <button
            type="button"
            class="work__filter mono"
            data-filter-btn={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <p class="mono work__count" data-work-count aria-live="polite">
      Showing {shots.length} of {shots.length}
    </p>

    <div class="work__grid" data-work-grid style={cols}>
      {
        shots.map((shot, i) => {
          const facts = [shot.propertyType, shot.area, shot.meta].filter(Boolean);
          return (
            <button
              type="button"
              class="work__item reveal"
              data-filter={shot.filter}
              data-lb={i}
              data-lb-src={lightboxSrc[i]}
              data-lb-caption={shot.caption}
              data-lb-meta={facts.join(' · ')}
            >
              <Picture
                src={shot.image}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[400, 800, 1200, 1600]}
                sizes="(min-width: 1040px) 372px, (min-width: 640px) 45vw, 90vw"
                alt={shot.caption}
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
              {facts.length > 0 && (
                <span class="work__overlay">
                  <span class="mono work__meta">
                    {facts.map((fact) => (
                      <span>{fact}</span>
                    ))}
                  </span>
                </span>
              )}
            </button>
          );
        })
      }
    </div>

    <p class="work__empty mono" data-work-empty hidden>
      Nothing in that category yet. Pick another filter, or ask what we have — the gallery is a
      sample, not the archive.
    </p>

    {
      hasMore && (
        <div class="work__more reveal">
          <a class="btn btn--ghost" href="/work/">
            See the full gallery
          </a>
        </div>
      )
    }
  </div>
</section>

<dialog class="lb" data-lightbox aria-label="Gallery image">
  <button class="lb__close" type="button" data-lb-close aria-label="Close">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <path d="M2 2 14 14M14 2 2 14" stroke="currentColor" stroke-width="1.6" />
    </svg>
  </button>
  <div class="lb__stage">
    <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Previous image">
      <svg viewBox="0 0 12 20" width="12" height="20" fill="none" aria-hidden="true"
        ><path d="M10 1 2 10l8 9" stroke="currentColor" stroke-width="1.6" /></svg
      >
    </button>
    <img class="lb__img" data-lb-img alt="" />
    <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label="Next image">
      <svg viewBox="0 0 12 20" width="12" height="20" fill="none" aria-hidden="true"
        ><path d="M2 1l8 9-8 9" stroke="currentColor" stroke-width="1.6" /></svg
      >
    </button>
  </div>
  <p class="lb__caption">
    <span class="mono" data-lb-meta></span>
    <span data-lb-text></span>
  </p>
</dialog>

<style>
  .work__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .work__filter {
    padding: 9px 15px;
    border: 1px solid var(--line);
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--t-hover) var(--ease), border-color var(--t-hover) var(--ease),
      background-color var(--t-hover) var(--ease);
  }
  .work__filter:hover {
    color: var(--paper);
    border-color: var(--line-lift);
  }
  .work__filter[aria-pressed='true'] {
    color: var(--paper);
    border-color: var(--edge-strong);
    background: var(--night);
  }

  .work__count {
    margin-bottom: 22px;
  }

  .work__grid {
    columns: var(--cols-sm, 1);
    column-gap: 14px;
  }

  .work__item {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0 0 14px;
    border: 1px solid var(--line-soft);
    background: var(--night);
    position: relative;
    cursor: zoom-in;
    break-inside: avoid;
    overflow: hidden;
    transition: border-color var(--t-hover) var(--ease);
  }
  .work__item:hover {
    border-color: var(--line-lift);
  }
  .work__item[hidden] {
    display: none;
  }
  .work__item picture {
    display: contents;
  }
  .work__item img {
    width: 100%;
    height: auto;
    transition: opacity var(--t-hover) var(--ease);
  }
  .work__item:hover img {
    opacity: 0.7;
  }

  .work__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 16px;
    opacity: 0;
    background: linear-gradient(180deg, rgb(var(--ink-c) / 0) 45%, rgb(var(--ink-c) / 0.88) 100%);
    transition: opacity var(--t-hover) var(--ease);
  }
  .work__item:hover .work__overlay,
  .work__item:focus-visible .work__overlay {
    opacity: 1;
  }
  .work__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    color: var(--paper);
    text-align: left;
  }
  .work__meta span + span::before {
    content: '· ';
    color: var(--muted);
  }

  .work__empty {
    padding: 40px 0;
    max-width: 52ch;
  }
  .work__more {
    margin-top: 34px;
  }

  @media (min-width: 640px) {
    .work__grid {
      columns: var(--cols-md, 2);
    }
  }
  @media (min-width: 1040px) {
    .work__grid {
      columns: var(--cols-lg, 3);
    }
  }

  /* --- Lightbox --- */

  .lb {
    width: min(1180px, 94vw);
    max-height: 92vh;
    padding: 0;
    border: 1px solid var(--line-lift);
    background: var(--night);
    color: var(--paper);
    overflow: visible;
  }
  .lb::backdrop {
    background: rgb(var(--ink-c) / 0.94);
  }
  .lb__stage {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
  }
  .lb__img {
    flex: 1;
    min-width: 0;
    max-height: 74vh;
    width: auto;
    margin-inline: auto;
    object-fit: contain;
  }
  .lb__nav,
  .lb__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    transition: border-color var(--t-hover) var(--ease), color var(--t-hover) var(--ease);
  }
  .lb__nav:hover,
  .lb__close:hover {
    border-color: var(--line-lift);
    color: var(--signal);
  }
  .lb__close {
    position: absolute;
    top: -1px;
    right: -1px;
    transform: translateY(-100%);
    border-bottom: 0;
  }
  .lb__caption {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 4px 18px 20px;
    color: var(--muted);
    font-size: var(--fs-14);
    max-width: 68ch;
  }
</style>

<script>
  import '../scripts/lightbox.js';
</script>
