---
import { packages, addOns } from '../data/pricing';
import { FREE_TRAVEL_RADIUS_MILES } from '../data/site';
---

<section class="section section--hair" id="pricing">
  <div class="wash wash--soft" aria-hidden="true"></div>

  <div class="wrap">
    <div class="section-head reveal">
      <p class="mono">What it costs</p>
      <h2 class="display">Priced by square footage</h2>
      <p class="prose">
        Square footage is what actually drives the time on site, so it is what drives the price.
        No quotes, no discovery call — pick the tier the house falls in.
      </p>
    </div>

    <div class="price">
      {
        packages.map((pkg) => (
          <article class:list={['price__card', 'reveal', pkg.featured && 'price__card--featured']}>
            {pkg.tag && <p class="mono price__tag">{pkg.tag}</p>}
            <h3 class="display price__name">{pkg.name}</h3>
            <p class="price__summary">{pkg.summary}</p>

            <dl class="price__tiers">
              {pkg.tiers.map((tier) => (
                <div class="price__tier">
                  <dt class="mono">{tier.label}</dt>
                  <dd>{tier.price}</dd>
                </div>
              ))}
            </dl>

            <ul class="price__list">
              {pkg.includes.map((line) => (
                <li>{line}</li>
              ))}
            </ul>

            <a
              class:list={['btn', 'btn--wide', pkg.featured ? 'btn--primary' : 'btn--ghost']}
              href="#book"
            >
              Book {pkg.name}
            </a>
          </article>
        ))
      }
    </div>

    <div class="addons reveal">
      <h3 class="mono addons__head">Add to any package</h3>
      <ul class="addons__list">
        {
          addOns.map((a) => (
            <li class="addons__row">
              <span class="addons__name">{a.name}</span>
              <span class="mono addons__note">{a.note}</span>
              <span class="addons__price">{a.price}</span>
            </li>
          ))
        }
      </ul>
      <p class="mono addons__foot">
        Travel within {FREE_TRAVEL_RADIUS_MILES} miles of Oxford is included · Sales tax added at
        invoice
      </p>
    </div>
  </div>
</section>

<style>
  .price {
    display: grid;
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .price__card {
    display: flex;
    flex-direction: column;
    background: var(--night);
    padding: 30px 26px 26px;
    position: relative;
  }
  .price__card--featured {
    background: color-mix(in srgb, var(--night) 72%, var(--cobalt));
  }

  .price__tag {
    color: var(--glow);
    margin-bottom: 14px;
  }
  /* Keeps the three cards' headings on the same baseline. */
  .price__card:not(.price__card--featured) .price__name {
    margin-top: calc(var(--fs-12) * 1.4 + 14px);
  }

  .price__name {
    font-size: var(--fs-28);
  }
  .price__summary {
    margin-top: 12px;
    color: var(--muted);
    font-size: var(--fs-14);
    max-width: 34ch;
  }

  .price__tiers {
    margin: 26px 0 0;
    border-top: 1px solid var(--line);
  }
  .price__tier {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 13px;
    border-bottom: 1px solid var(--line);
  }
  .price__tier dd {
    margin: 0;
    font-size: var(--fs-20);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .price__list {
    margin: 24px 0 30px;
    display: grid;
    gap: 10px;
    font-size: var(--fs-14);
    color: var(--muted);
  }
  .price__list li {
    padding-left: 20px;
    position: relative;
  }
  .price__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 1px;
    background: var(--horizon);
  }
  .price__card .btn {
    margin-top: auto;
  }

  .addons {
    margin-top: clamp(44px, 5vw, 68px);
    border: 1px solid var(--line-soft);
    background: var(--night);
    padding: 28px 26px;
  }
  .addons__head {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .addons__list {
    display: grid;
  }
  .addons__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    align-items: baseline;
    padding-block: 15px;
    border-bottom: 1px solid var(--line);
  }
  .addons__name {
    font-size: var(--fs-16);
  }
  .addons__note {
    grid-column: 1 / 2;
  }
  .addons__price {
    grid-row: 1 / 3;
    grid-column: 2 / 3;
    font-size: var(--fs-20);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .addons__foot {
    padding-top: 20px;
  }

  @media (min-width: 900px) {
    .price {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .price__card {
      padding: 34px 30px 30px;
    }
    .addons__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }
    .addons {
      padding: 32px 30px;
    }
  }
</style>
