---
import { packages, addOns } from '../data/pricing';
import { FREE_TRAVEL_RADIUS_MILES, BOOKING_LINK, BOOKING_NEW_TAB } from '../data/site';
---

<section class="section section--hair" id="pricing">
  <div class="wash wash--soft" aria-hidden="true"></div>

  <div class="wrap">
    <div class="section-head reveal">
      <p class="mono">What it costs</p>
      <h2 class="display">Starting prices</h2>
      <p class="prose">
        No tiers and no discovery call. Add-ons go on top of any booking.
      </p>
    </div>

    <div class="price">
      {
        packages.map((pkg) => (
          <article class="price__card reveal">
            <h3 class="display price__name">{pkg.name}</h3>
            <p class="price__summary">{pkg.summary}</p>
            <p class="price__amount">{pkg.price}</p>
            <a class="btn btn--ghost btn--wide" {...BOOKING_LINK}>
              Book {pkg.name.toLowerCase()}
              {BOOKING_NEW_TAB && <span class="visually-hidden"> (opens in a new tab)</span>}
            </a>
          </article>
        ))
      }
    </div>

    <div class="addons reveal">
      <h3 class="mono addons__head">Add to any package</h3>
      <ul class="addons__list">
        {
          addOns.map((a) => (
            <li class="addons__row">
              <span class="addons__name">{a.name}</span>
              <span class="mono addons__note">{a.note}</span>
              <span class="addons__price">{a.price}</span>
            </li>
          ))
        }
      </ul>
      <p class="mono addons__foot">
        Travel within {FREE_TRAVEL_RADIUS_MILES} miles of Oxford is included
      </p>
    </div>
  </div>
</section>

<style>
  .price {
    display: grid;
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .price__card {
    display: flex;
    flex-direction: column;
    background: var(--night);
    padding: 30px 26px 26px;
    position: relative;
  }
  .price__name {
    font-size: var(--fs-28);
  }
  .price__summary {
    margin-top: 12px;
    color: var(--muted);
    font-size: var(--fs-14);
    max-width: 34ch;
  }

  .price__amount {
    margin: 26px 0 30px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-28);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .price__card .btn {
    margin-top: auto;
  }

  .addons {
    margin-top: clamp(44px, 5vw, 68px);
    border: 1px solid var(--line-soft);
    background: var(--night);
    padding: 28px 26px;
  }
  .addons__head {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .addons__list {
    display: grid;
  }
  .addons__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    align-items: baseline;
    padding-block: 15px;
    border-bottom: 1px solid var(--line);
  }
  .addons__name {
    font-size: var(--fs-16);
  }
  .addons__note {
    grid-column: 1 / 2;
  }
  .addons__price {
    grid-row: 1 / 3;
    grid-column: 2 / 3;
    font-size: var(--fs-20);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .addons__foot {
    padding-top: 20px;
  }

  @media (min-width: 900px) {
    .price {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .price__card {
      padding: 34px 30px 30px;
    }
    .addons__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }
    .addons {
      padding: 32px 30px;
    }
  }
</style>
