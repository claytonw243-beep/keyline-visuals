---
import { towns, FREE_TRAVEL_RADIUS_MILES } from '../data/site';
---

<section class="section section--hair" id="coverage">
  <div class="wrap cov">
    <div class="cov__copy reveal">
      <p class="mono">Where we shoot</p>
      <h2 class="display cov__title">Based in Oxford, working across North Mississippi</h2>
      <p class="prose cov__body">
        We are based in Oxford and shoot across North Mississippi. Travel within {
          FREE_TRAVEL_RADIUS_MILES
        } miles of Oxford is included. Further out, tell us at booking and we'll quote the trip
        with it.
      </p>
    </div>

    <ul class="cov__towns reveal">
      {towns.map((t) => <li class="cov__town">{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .cov {
    display: grid;
    gap: clamp(36px, 4vw, 60px);
  }
  .cov__title {
    margin-top: 18px;
    font-size: var(--fs-40);
  }
  .cov__body {
    margin-top: 22px;
  }
  .cov__towns {
    display: grid;
    gap: 0;
    align-content: start;
    border-top: 1px solid var(--line);
  }
  .cov__town {
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-16);
  }

  @media (min-width: 900px) {
    .cov {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
    }
    .cov__towns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 28px;
    }
  }
</style>
