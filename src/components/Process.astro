---
import { TURNAROUND, EXTRAS_TURNAROUND } from '../data/site';

const steps = [
  {
    stamp: 'Shoot day',
    title: 'We show up ready and you do not have to be there',
    body: 'Everything we need comes in at booking: the address and the square footage. A drone comes too if the package has one. A 2,500 square foot house takes about an hour, and you get a text when we are done.',
  },
  {
    stamp: TURNAROUND,
    title: `Photos are in your inbox within ${TURNAROUND}`,
    body: `Edited and delivered inside a day: exposure blended, verticals straightened, color corrected room by room. The gallery link has MLS-sized files in one folder and full-resolution in another, so you are not resizing anything before you upload. Video, floor plans, and virtual staging follow within ${EXTRAS_TURNAROUND}.`,
  },
  {
    stamp: 'Same week',
    title: 'If something changes, we come back',
    body: 'If the seller changes something after the shoot — fresh paint, furniture moved, landscaping finished — we come back for a partial reshoot rather than letting you list a photo that is now wrong. The invoice comes with the gallery.',
  },
];
---

<section class="section section--hair" id="process">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="mono">How it runs</p>
      <h2 class="display">From booking to live</h2>
      <p class="prose">
        All we need from you is the address and the square footage. Everything after that runs on a
        clock.
      </p>
    </div>

    <ol class="proc">
      {
        steps.map((step) => (
          <li class="proc__step reveal">
            <p class="mono proc__stamp">{step.stamp}</p>
            <h3 class="proc__title">{step.title}</h3>
            <p class="proc__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proc {
    display: grid;
    gap: 42px;
    position: relative;
  }

  .proc__stamp {
    padding-top: 22px;
    border-top: 1px solid var(--line);
    position: relative;
  }
  /* The connecting rule: cobalt on the left, signal by the last step. */
  .proc__step:nth-child(1) .proc__stamp {
    border-image: linear-gradient(90deg, var(--cobalt), var(--horizon)) 1;
  }
  .proc__step:nth-child(2) .proc__stamp {
    border-image: linear-gradient(90deg, var(--horizon), color-mix(in srgb, var(--horizon) 50%, var(--signal))) 1;
  }
  .proc__step:nth-child(3) .proc__stamp {
    border-image: linear-gradient(90deg, color-mix(in srgb, var(--horizon) 50%, var(--signal)), var(--signal)) 1;
  }

  .proc__title {
    margin-top: 18px;
    font-size: var(--fs-20);
    font-weight: 500;
    line-height: 1.3;
    max-width: 26ch;
  }
  .proc__body {
    margin-top: 14px;
    color: var(--muted);
    font-size: var(--fs-14);
    max-width: 60ch;
  }

  @media (min-width: 860px) {
    .proc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 36px;
    }
  }
</style>
