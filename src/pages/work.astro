---
import BaseLayout from '../layouts/BaseLayout.astro';
import Work from '../components/Work.astro';
import BookingForm from '../components/BookingForm.astro';
---

<BaseLayout
  title="Work — Keyline Visuals"
  description="Real estate photography, aerial, twilight, and video from listings across Oxford, Lafayette County, Tupelo, and North Mississippi."
>
  <Work
    headingLevel="h1"
    eyebrow="Gallery"
    heading="Every frame is a real listing"
    intro="Interiors, exteriors, aerial, twilight, and video from houses across the coverage area. Filter it down to whatever you are about to put on the market."
  />
  <BookingForm />
</BaseLayout>
