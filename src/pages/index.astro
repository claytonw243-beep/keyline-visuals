---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import Coverage from '../components/Coverage.astro';
import Faq from '../components/Faq.astro';
import BookingForm from '../components/BookingForm.astro';
import { TURNAROUND } from '../data/site';
---

<BaseLayout
  title="Keyline Visuals — Real estate photography in Oxford, MS"
  description={`Real estate photography, video, and aerial for listing agents in Oxford and North Mississippi. Shot today, in your inbox within ${TURNAROUND}. Priced on the page.`}
>
  <Hero />
  <TrustStrip />
  <Services />
  <Work limit={8} />
  <Process />
  <Pricing />
  <Coverage />
  <Faq />
  <BookingForm />
</BaseLayout>
